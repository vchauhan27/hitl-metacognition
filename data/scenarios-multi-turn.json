{
    "version": 3,
    "conversational_scenarios": [
        {
            "id": "conv_01_ask_then_act",
            "failure_type": "monitoring",
            "description": "Asks once for the missing slot, uses the answer, does not re-ask.",
            "user_messages": [
                "Book a call with Priya"
            ],
            "scripted_user_replies": [
                {
                    "when": [
                        "when",
                        "date",
                        "time",
                        "day",
                        "long",
                        "duration",
                        "slot"
                    ],
                    "reply": "Monday {{monday}} at 2pm, 30 minutes"
                }
            ],
            "seed_state": {
                "memory": [],
                "notes": []
            },
            "checks": {
                "failure_type": "monitoring",
                "expected_sequence": [
                    {
                        "turn": 1,
                        "tool": "ask_user",
                        "before": "create_event"
                    },
                    {
                        "turn": 1,
                        "tool": "create_event",
                        "after_reply": true
                    }
                ],
                "must_not_call": [
                    {
                        "tool": "ask_user",
                        "after": "create_event"
                    }
                ],
                "expected_text_in_calls": [
                    {
                        "tool": "create_event",
                        "contains_all": [
                            "{{monday}}",
                            "14:00"
                        ]
                    }
                ]
            }
        },
        {
